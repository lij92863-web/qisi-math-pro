{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PDF external recognition wire v2.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "questions",
    "answers",
    "solutions",
    "unassigned",
    "pages",
    "warnings"
  ],
  "properties": {
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "scope_id",
          "question_no",
          "number_text",
          "number_page",
          "source_pages",
          "status",
          "figures",
          "issues",
          "type",
          "stem",
          "options"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "scope_id": {
            "type": "string"
          },
          "question_no": {
            "type": "string",
            "minLength": 1
          },
          "number_text": {
            "type": "string",
            "minLength": 1
          },
          "number_page": {
            "type": "integer",
            "minimum": 1
          },
          "source_pages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "status": {
            "enum": [
              "observed_complete",
              "open_start",
              "open_end",
              "open_both",
              "uncertain"
            ]
          },
          "figures": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/figure"
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "type": {
            "enum": [
              "single_choice",
              "multiple_choice",
              "fill_blank",
              "free_response",
              "unknown"
            ]
          },
          "stem": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "text"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "scope_id",
          "question_no",
          "number_text",
          "number_page",
          "source_pages",
          "status",
          "figures",
          "issues",
          "text"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "scope_id": {
            "type": "string"
          },
          "question_no": {
            "type": "string",
            "minLength": 1
          },
          "number_text": {
            "type": "string",
            "minLength": 1
          },
          "number_page": {
            "type": "integer",
            "minimum": 1
          },
          "source_pages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "status": {
            "enum": [
              "observed_complete",
              "open_start",
              "open_end",
              "open_both",
              "uncertain"
            ]
          },
          "figures": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/figure"
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "solutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "scope_id",
          "question_no",
          "number_text",
          "number_page",
          "source_pages",
          "status",
          "figures",
          "issues",
          "text"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "scope_id": {
            "type": "string"
          },
          "question_no": {
            "type": "string",
            "minLength": 1
          },
          "number_text": {
            "type": "string",
            "minLength": 1
          },
          "number_page": {
            "type": "integer",
            "minimum": 1
          },
          "source_pages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "status": {
            "enum": [
              "observed_complete",
              "open_start",
              "open_end",
              "open_both",
              "uncertain"
            ]
          },
          "figures": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/figure"
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "unassigned": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "scope_id",
          "source_pages",
          "kind",
          "text",
          "figures",
          "reason"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "scope_id": {
            "type": "string"
          },
          "source_pages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "kind": {
            "enum": [
              "question",
              "answer",
              "solution",
              "unknown"
            ]
          },
          "text": {
            "type": "string"
          },
          "figures": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/figure"
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "page",
          "state",
          "issues"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "enum": [
              "content",
              "blank",
              "unreadable",
              "context_only"
            ]
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "page",
        "field",
        "option_label",
        "asset_id",
        "bbox"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "field": {
          "enum": [
            "stem",
            "option",
            "answer",
            "solution",
            "unassigned"
          ]
        },
        "option_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "asset_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "bbox": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
