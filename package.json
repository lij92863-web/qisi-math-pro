{
  "name": "qisi-math-pro-local",
  "version": "1.0.0",
  "private": true,
  "description": "Qisi Math Pro local service",
  "main": "qisi-local-server.js",
  "scripts": {
    "start": "node qisi-local-server.js",
    "check": "node scripts/check-runtime-syntax.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "smoke:batch:mock": "node --test tests/batch-smoke-mock.test.js",
    "verify:docx-stable": "node scripts/verify-docx-stable.js",
    "verify:pdf-known-bad": "node scripts/verify-pdf-known-bad.js",
    "verify:batch-safety": "node scripts/verify-batch-safety.js",
    "verify:no-real-ai": "node scripts/verify-no-real-ai.js",
    "verify:diff-scope": "node scripts/verify-diff-scope.js",
    "verify:safe": "npm run verify:no-real-ai && npm run check && npm test && node scripts/verify-write-boundary.js",
    "verify": "npm run check && npm test",
    "verify:personal-stable": "node scripts/verify-personal-stable.js",
    "test:ai-proxy": "node scripts/smoke-ai-proxy.js",
    "test:ai-vision-proxy": "node scripts/smoke-ai-vision-proxy.js",
    "backup:stage0": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-stage0-snapshot.ps1",
    "test:quick": "node --test tests/app-shell-c2-12-final-convergence.test.js tests/backup-workspace.test.js tests/batch-smoke-mock.test.js tests/docx-pipeline.test.js tests/mineru-task-lifecycle.test.js tests/video-workspace.test.js",
    "test:unit": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.test.js\""
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "4.22.3",
    "multer": "2.4.0",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "acorn": "^8.15.0",
    "dexie": "^3.2.4",
    "jszip": "^3.10.1",
    "katex": "0.16.47",
    "lucide": "^0.378.0",
    "playwright": "^1.61.0",
    "vue": "^3.4.27",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  }
}
